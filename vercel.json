{
 "cleanUrls": true,
 "trailingSlash": false,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    }
   ]
  },
  {
   "source": "/hero.mp4",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  }
 ]
}